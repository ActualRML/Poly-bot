{
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.secret)",
      "Read(./.env.*.local)",
      "Edit(./.env)",
      "Edit(./.env.local)",
      "Edit(./.env.secret)",
      "Edit(./.env.*.local)",
      "Write(./.env)",
      "Write(./.env.local)",
      "Write(./.env.secret)",
      "Write(./.env.*.local)",
      "Bash(cat .env)",
      "Bash(cat .env.local)",
      "Bash(cat .env.secret)",
      "Bash(type .env)",
      "Bash(type .env.local)",
      "Bash(type .env.secret)",
      "Bash(Get-Content .env)",
      "Bash(Get-Content .env.local)",
      "Bash(Get-Content .env.secret)",
      "Bash(cp .env *)",
      "Bash(copy .env *)",
      "Bash(echo * > .env)",
      "Bash(echo * >> .env)",
      "Bash(rm -rf *)",
      "Bash(Remove-Item -Recurse -Force *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)"
    ],
    "allow": [
      "Read(./.env.example)",
      "Edit(./.env.example)",
      "Write(./.env.example)",
      "Bash(python -m py_compile *)",
      "Bash(python -m pytest *)",
      "Bash(python -c *)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git mv *)",
      "Bash(git stash *)",
      "Bash(mkdir -p src/_archive)",
      "Bash(sqlite3 data/*.db *)"
    ]
  }
}