# --- RUNTIME ---
# DRY_RUN=true means the executor logs decisions but never places orders.
# Live mode is intentionally not wired yet - flipping this flag alone does nothing.
DRY_RUN=true
LOG_LEVEL=INFO

# --- PATHS (relative to project root) ---
DB_PATH=data/bot.db
LOG_DIR=logs

# --- STRATEGY PLUGINS (comma-separated module names under src/strategy/) ---
# Order is load-bearing: contrarian is FIRST so it wins is_held collisions on
# shared markets (it triggers on the same zones as momentum). momentum is the
# shadow/test strategy — its decisions are logged but it's blocked from holding
# whenever contrarian already opened that market.
ACTIVE_STRATEGIES=contrarian,momentum

# --- ENDPOINTS ---
POLYMARKET_WS_URL=wss://ws-subscriptions-clob.polymarket.com/ws/market
POLYMARKET_GAMMA_URL=https://gamma-api.polymarket.com
POLYMARKET_CLOB_URL=https://clob.polymarket.com
BINANCE_WS_URL=wss://stream.binance.com:9443
