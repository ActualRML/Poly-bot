# ── DAILY CRYPTO STRATEGY ────────────────────────────────────────
HOURLY_MAX_MINUTES_TO_RESOLVE=1440
HOURLY_MIN_MINUTES_TO_RESOLVE=30
HOURLY_MISPRICING_THRESHOLD=0.12
HOURLY_MIN_WINRATE_STRICT=0.75
HOURLY_MIN_MARKET_VOLUME=5000
HOURLY_MIN_LIQUIDITY=200
HOURLY_VOL_HOURS=4

# ── UP/DOWN DAILY STRATEGY ───────────────────────────────────────
UPDOWN_THRESHOLD=0.05
UPDOWN_MIN_WINRATE=0.55
UPDOWN_MAX_HOURS=8.0
UPDOWN_DAILY_MIN_HOURS_TO_RESOLVE=2.0   # skip entry kalau T < 2h (vol regime risk)

# ── UP/DOWN HOURLY STRATEGY ──────────────────────────────────────
UPDOWN_HOURLY_THRESHOLD=0.07
UPDOWN_HOURLY_MIN_WINRATE=0.55
UPDOWN_HOURLY_MAX_MINUTES=90
UPDOWN_HOURLY_CANDLE_OPEN_MIN=5
UPDOWN_HOURLY_MOMENTUM_MINUTES=15
UPDOWN_HOURLY_MOMENTUM_THRESHOLD=0.0015
UPDOWN_HOURLY_MOMENTUM_MAX=0.012
UPDOWN_HOURLY_MIN_VOL_RATIO=0.5
UPDOWN_HOURLY_MAX_ENTRY_PRICE=0.50

# ── GBM PROBABILITY STRATEGY (replace contrarian) ────────────────
UPDOWN_HOURLY_USE_GBM=true        # false → fallback ke contrarian lama
UPDOWN_HOURLY_GBM_MIN_EDGE=0.15   # min edge 15% post-fee — backtest: ~5/hari real, wr 58-63%, ROI +89%/trade
                                  # 0.20 untuk wr 65%+ (3-4/hari), 0.10 untuk lebih banyak trade (wr ~55%)
UPDOWN_HOURLY_FEE=0.018           # Polymarket taker fee 1.8%

# ── OPPOSITE RE-ENTRY (post-TP fakeout reversal capture) ─────────
UPDOWN_HOURLY_OPPOSITE_REENTRY=true        # set false untuk disable (rec: false di live awal)
UPDOWN_HOURLY_OPPOSITE_MIN_MINUTES=10      # hard floor — minimum 10m left untuk re-entry

# ── VOL FLOOR (anti over-confident model di calm-before-storm) ───
UPDOWN_VOL_FLOOR=0.50              # min annualized vol (0 untuk disable)

# ── KELLY & POSITION SIZING ──────────────────────────────────────
KELLY_MULTIPLIER=0.5
MAX_KELLY_FRACTION=0.30
MIN_BET_USDC=5.0
MIN_WINRATE=0.15
MAX_OPEN_POSITIONS=5
MAX_CAPITAL_PER_MARKET=30
MAX_SAME_DIRECTION=0
MAX_POSITIONS_PER_SLOT=0
MIN_PROFIT_PCT=0.20

# ── EXIT STRATEGY ────────────────────────────────────────────────
TRAILING_STOP_PCT=0.15
TIGHT_TRAILING_STOP_PCT=0.07
PROFIT_THRESHOLD=0.75
PROFIT_LOCK_PCT=20.0
PROFIT_LOCK_HIGH_PCT=35.0
UPDOWN_PROFIT_LOCK_PCT=40.0
UPDOWN_PROFIT_LOCK_HIGH_PCT=60.0
HOURLY_PROFIT_LOCK_PCT=30.0
HOURLY_PROFIT_LOCK_HIGH_PCT=50.0
HOURLY_TRAILING_ACTIVATE_PCT=15.0
HOURLY_TRAILING_RETRACE_PCT=0.30

# ── CIRCUIT BREAKER ──────────────────────────────────────────────
MAX_DRAWDOWN_PCT=0.40
MAX_DAILY_LOSS_PCT=0.20
MAX_CONSECUTIVE_LOSSES=5

# ── SYSTEM ───────────────────────────────────────────────────────
SALDO_AWAL=120
POLLING_INTERVAL_DETIK=30
DRY_RUN=True
CB_ENABLED=False
LOG_LEVEL=INFO
