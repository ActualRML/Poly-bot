# ── AUTHENTICATION & API KEYS ────────────────────────────────────
# Copy file ini ke .env.secret dan isi dengan nilai yang sebenarnya
# JANGAN commit .env.secret ke git

PK_PRIVATE_KEY=
CLOB_API_KEY=
CLOB_SECRET=
CLOB_PASS=

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── DAILY CRYPTO STRATEGY ────────────────────────────────────────
# Market "Will BTC be above $X?" yang resolve dalam 5–90 menit
HOURLY_MAX_MINUTES_TO_RESOLVE=1440
HOURLY_MIN_MINUTES_TO_RESOLVE=30
HOURLY_MISPRICING_THRESHOLD=0.12
HOURLY_MIN_WINRATE_STRICT=0.75
HOURLY_MIN_MARKET_VOLUME=500
HOURLY_MIN_LIQUIDITY=200
HOURLY_VOL_HOURS=4

# ── UP/DOWN DAILY STRATEGY ────────────────────────────────────────
# Market "BTC Up or Down on May 4?" — resolve sekali sehari 16:00 UTC
UPDOWN_THRESHOLD=0.05
UPDOWN_MIN_WINRATE=0.55
UPDOWN_MAX_HOURS=8.0

# ── UP/DOWN HOURLY STRATEGY ───────────────────────────────────────
# Market "BTC Up or Down - May 4, 1PM ET" — resolve setiap jam
UPDOWN_HOURLY_THRESHOLD=0.05
UPDOWN_HOURLY_MIN_WINRATE=0.55
UPDOWN_HOURLY_MAX_MINUTES=90

# ── KELLY & POSITION SIZING ──────────────────────────────────────
KELLY_MULTIPLIER=0.5
MAX_KELLY_FRACTION=0.30
MIN_BET_USDC=5.0
MIN_WINRATE=0.15
MAX_OPEN_POSITIONS=5
MAX_CAPITAL_PER_MARKET=30
MIN_PROFIT_PCT=0.08

# ── EXIT STRATEGY ────────────────────────────────────────────────
TRAILING_STOP_PCT=0.15
TIGHT_TRAILING_STOP_PCT=0.07
PROFIT_THRESHOLD=0.75

# ── CIRCUIT BREAKER ──────────────────────────────────────────────
MAX_DRAWDOWN_PCT=0.20
MAX_DAILY_LOSS_PCT=0.10
MAX_CONSECUTIVE_LOSSES=3

# ── SYSTEM ───────────────────────────────────────────────────────
SALDO_AWAL=120
POLLING_INTERVAL_DETIK=30
DRY_RUN=True
LOG_LEVEL=INFO
