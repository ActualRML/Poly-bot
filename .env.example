# ── AUTHENTICATION & API KEYS ────────────────────────────────────
# Copy file ini ke .env.secret dan isi dengan nilai yang sebenarnya
# JANGAN commit .env.secret ke git

PK_PRIVATE_KEY=
CLOB_API_KEY=
CLOB_SECRET=
CLOB_PASS=
FRED_API_KEY=

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── HOURLY STRATEGY ──────────────────────────────────────────────
# Copy file ini ke .env.local untuk override strategy params
# Nilai di bawah adalah default yang direkomendasikan

HOURLY_MAX_MINUTES_TO_RESOLVE=1440
HOURLY_MIN_MINUTES_TO_RESOLVE=30
HOURLY_MISPRICING_THRESHOLD=0.12
HOURLY_MIN_WINRATE_STRICT=0.75
HOURLY_MIN_MARKET_VOLUME=500
HOURLY_MIN_LIQUIDITY=200
HOURLY_VOL_HOURS=4

# ── KELLY & POSITION SIZING ──────────────────────────────────────
KELLY_MULTIPLIER=0.5
MAX_KELLY_FRACTION=0.30
MIN_BET_USDC=5.0
MIN_WINRATE=0.15
MAX_OPEN_POSITIONS=5
MAX_CAPITAL_PER_MARKET=30
MIN_PROFIT_PCT=0.08

# ── EXIT STRATEGY ────────────────────────────────────────────────
TRAILING_STOP_PCT=0.15
TIGHT_TRAILING_STOP_PCT=0.07
PROFIT_THRESHOLD=0.75

# ── CIRCUIT BREAKER ──────────────────────────────────────────────
MAX_DRAWDOWN_PCT=0.20
MAX_DAILY_LOSS_PCT=0.10
MAX_CONSECUTIVE_LOSSES=3

# ── SYSTEM ───────────────────────────────────────────────────────
SALDO_AWAL=120
POLLING_INTERVAL_DETIK=30
DRY_RUN=True
LOG_LEVEL=INFO
