# ── DAILY CRYPTO STRATEGY ────────────────────────────────────────
HOURLY_MAX_MINUTES_TO_RESOLVE=1440
HOURLY_MIN_MINUTES_TO_RESOLVE=30
HOURLY_MISPRICING_THRESHOLD=0.12
HOURLY_MIN_WINRATE_STRICT=0.75
HOURLY_MIN_MARKET_VOLUME=5000
HOURLY_MIN_LIQUIDITY=200
HOURLY_VOL_HOURS=4

# ── UP/DOWN DAILY STRATEGY ───────────────────────────────────────
UPDOWN_THRESHOLD=0.05
UPDOWN_MIN_WINRATE=0.55
UPDOWN_MAX_HOURS=8.0
UPDOWN_DAILY_MIN_HOURS_TO_RESOLVE=2.0

# ── UP/DOWN HOURLY / CANDLE (time gates) ─────────────────────────
UPDOWN_HOURLY_MAX_MINUTES=90
UPDOWN_HOURLY_CANDLE_OPEN_MIN=7        # skip X menit pertama candle (default: 7)
UPDOWN_HOURLY_MIN_T_MINUTES=15         # min waktu tersisa untuk entry (default: 15)
UPDOWN_HOURLY_MAX_ENTRY_PRICE=0.50     # max buy price — naikkan dari 0.45 untuk lebih banyak entry
UPDOWN_HOURLY_MIN_VOL_RATIO=0.5        # min volume ratio vs 30-bar baseline (default: 0.5)
UPDOWN_HOURLY_CONSENSUS_FLOOR=0.85     # blok entry jika pasar terlalu consensus satu arah (default: 0.85)
UPDOWN_HOURLY_BTC_CORR_THR=0.010      # BTC correlation block threshold (default: 0.010)

# ── GBM PROBABILITY MODEL ────────────────────────────────────────
UPDOWN_HOURLY_USE_GBM=true
UPDOWN_HOURLY_GBM_MIN_EDGE=0.02        # min GBM edge post-fee (0.02=volume tinggi, 0.05=selektif)
UPDOWN_HOURLY_GBM_MAX_EDGE=0.25        # edge terlalu tinggi = unreliable signal, skip
UPDOWN_GBM_VOL_EDGE_FACTOR=0.07        # vol-scale: adj_min_edge = max(GBM_MIN_EDGE, vol × factor)
UPDOWN_HOURLY_FEE=0.018                # Polymarket taker fee 1.8%
UPDOWN_VOL_FLOOR=0.50                  # min annualized vol (0 = disable)

# ── CANDLE STRATEGY ──────────────────────────────────────────────
CANDLE_UPDOWN_MOM_VOL_FACTOR=0.003     # vol-scale momentum threshold: adj = max(base, vol × factor)

# ── OPPOSITE RE-ENTRY (post-TP fakeout reversal) ─────────────────
UPDOWN_HOURLY_OPPOSITE_REENTRY=true
UPDOWN_HOURLY_OPPOSITE_MIN_MINUTES=10

# ── SLOT & POSITION CAPS ─────────────────────────────────────────
MAX_POSITIONS_PER_SLOT=3               # max posisi OPEN bersamaan per time slot
UPDOWN_HOURLY_MAX_ENTRIES_PER_SLOT=6   # max entry kumulatif per slot (termasuk re-entry)
MAX_OPEN_POSITIONS=8                   # global cap semua posisi aktif
MAX_SAME_DIRECTION=3                   # max Up atau Down bersamaan

# ── KELLY & POSITION SIZING ──────────────────────────────────────
KELLY_MULTIPLIER=0.5
MAX_KELLY_FRACTION=0.30
MIN_BET_USDC=5.0
MIN_WINRATE=0.15
MAX_CAPITAL_PER_MARKET=30
MIN_PROFIT_PCT=0.20

# ── EXIT STRATEGY ────────────────────────────────────────────────
TRAILING_STOP_PCT=0.15
TIGHT_TRAILING_STOP_PCT=0.07
PROFIT_THRESHOLD=0.75
PROFIT_LOCK_PCT=20.0
PROFIT_LOCK_HIGH_PCT=35.0
UPDOWN_PROFIT_LOCK_PCT=40.0
UPDOWN_PROFIT_LOCK_HIGH_PCT=60.0
HOURLY_LOCK_T1_PCT=150.0               # T1 profit lock: PnL ≥ ini + >5m left → exit
HOURLY_LOCK_T2_PCT=100.0               # T2 profit lock: PnL ≥ ini + >15m left → exit
HOURLY_TRAILING_ACTIVATE_PCT=15.0
HOURLY_TRAILING_RETRACE_PCT=0.30

# ── CIRCUIT BREAKER ──────────────────────────────────────────────
MAX_DRAWDOWN_PCT=0.40
MAX_DAILY_LOSS_PCT=0.20
MAX_CONSECUTIVE_LOSSES=5

# ── SYSTEM ───────────────────────────────────────────────────────
SALDO_AWAL=120
POLLING_INTERVAL_DETIK=30
DRY_RUN=True
CB_ENABLED=False
LOG_LEVEL=INFO
